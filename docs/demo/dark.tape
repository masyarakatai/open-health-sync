# Dark variant of the README demo. From the repository root: vhs docs/demo/dark.tape
Output docs/demo/demo-dark.gif
Set Theme { "name": "ohs-dark", "background": "#161b22", "foreground": "#e6edf3", "selection": "#264f78", "cursor": "#e6edf3", "black": "#484f58", "red": "#ff7b72", "green": "#7ee2b8", "yellow": "#e3b341", "blue": "#3cc9b6", "magenta": "#d2a8ff", "cyan": "#76e3ea", "white": "#b1bac4", "brightBlack": "#7d8590", "brightRed": "#ffa198", "brightGreen": "#7ee2b8", "brightYellow": "#f0c55a", "brightBlue": "#3cc9b6", "brightMagenta": "#e2c5ff", "brightCyan": "#b3f0ff", "brightWhite": "#ffffff" }
Set MarginFill "#0d1117"
Source docs/demo/demo.tape
